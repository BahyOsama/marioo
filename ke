                      final value = int.tryParse(_valueController.text) ?? 500;
                      final condition = _conditionController.text;

                      Provider.of<CouponProvider>(
                        context,
                        listen: false,
                      ).generateCoupon(
                        code,
                        value,
                        const Duration(days: 7),
                        condition,
                      );

                      _couponController.clear();
                      _valueController.clear();
                      _conditionController.clear();

                      ScaffoldMessenger.of(context).showSnackBar(
                        SnackBar(
                          content: Text(
                            '${AppLocalizations.of(context, 'coupon_generated')}!',
                          ),
                        ),
                      );
                    },
                    child: Text(AppLocalizations.of(context, 'generate')),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 24),
          Text(
            AppLocalizations.of(context, 'active_coupons'),
            style: Theme.of(context).textTheme.titleLarge,
          ),
          const SizedBox(height: 16),
          if (coupons.isEmpty)
            Padding(
              padding: const EdgeInsets.all(16),
              child: Text(AppLocalizations.of(context, 'no_active_coupons')),
            ),
          ...coupons.map(
            (coupon) => Card(
              margin: const EdgeInsets.only(bottom: 12),
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
              child: ListTile(
                title: Text(
