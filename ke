class GameProvider with ChangeNotifier {
  GameState _gameState = GameState(
    status: GameStatus.lobby,
    score: 0,
    opponentScore: 0,
    timeLeft: 0,
  );

  GameState get gameState => _gameState;

  void startGame() {
    _gameState = GameState(
      status: GameStatus.playing,
      score: 0,
      opponentScore: 0,
      timeLeft: 180,
    );
    notifyListeners();

    _startTimer();
  }

  void _startTimer() {
    const oneSec = Duration(seconds: 1);
    Timer.periodic(oneSec, (timer) {
      if (_gameState.timeLeft <= 0) {
        timer.cancel();
        _endGame();
        return;
      }

      if (_gameState.status == GameStatus.playing) {
        _gameState = _gameState.copyWith(timeLeft: _gameState.timeLeft - 1);
        notifyListeners();
      } else {
        timer.cancel();
      }
    });
  }

  void updateScore(int points) {
    _gameState = _gameState.copyWith(score: _gameState.score + points);
    notifyListeners();

    if (_gameState.score >= 152) {
      _endGame(isWin: true);
    }
  }

  void _endGame({bool isWin = false}) {
    _gameState = _gameState.copyWith(
      status: isWin ? GameStatus.won : GameStatus.lost,
    );
    notifyListeners();

    if (isWin) {
      Provider.of<UserProvider>(
        navigatorKey.currentContext!,
        listen: false,
      ).updateBalance(500);
    }
  }
}

// Models
class User {
  final String id;
  final String name;
  final int balance;
  final int wins;
  final int losses;
  final int rank;
  final String backgroundImage;
  final String frame;
  final String language;
  final String themeMode;

  User({
    required this.id,
    required this.name,
    required this.balance,
    required this.wins,
    required this.losses,
    required this.rank,
    required this.backgroundImage,
    required this.frame,
    required this.language,
    required this.themeMode,
  });

  User copyWith({
    String? name,
    int? balance,
    int? wins,
    int? losses,
    int? rank,
    String? backgroundImage,
    String? frame,
    String? language,
    String? themeMode,
  }) {
    return User(
      id: id,
      name: name ?? this.name,
      balance: balance ?? this.balance,
      wins: wins ?? this.wins,
      losses: losses ?? this.losses,
      rank: rank ?? this.rank,
      backgroundImage: backgroundImage ?? this.backgroundImage,
      frame: frame ?? this.frame,
      language: language ?? this.language,
      themeMode: themeMode ?? this.themeMode,
    );
  }

  double get winRatio => wins / (wins + losses);
}

class Tournament {
  final String id;
  final String name;
  final int prize;
  final int players;
  final int maxPlayers;
  final DateTime startTime;
  final TournamentRules rules;

  Tournament({
    required this.id,
    required this.name,
    required this.prize,
    required this.players,
    required this.maxPlayers,
    required this.startTime,
    required this.rules,
  });

  Tournament copyWith({int? players}) {
    return Tournament(
      id: id,
      name: name,
      prize: prize,
      players: players ?? this.players,
      maxPlayers: maxPlayers,
      startTime: startTime,
      rules: rules,
    );
  }

  String get timeLeft {
    final now = DateTime.now();
    if (startTime.isBefore(now)) return 'Started';

    final diff = startTime.difference(now);
    if (diff.inDays > 0) return '${diff.inDays} days';
    if (diff.inHours > 0) return '${diff.inHours} hours';
    return '${diff.inMinutes} min';
  }
}

class TournamentRules {
  final int rounds;
  final int winCondition;
  final String emergencyRules;

  TournamentRules({
    required this.rounds,
    required this.winCondition,
    required this.emergencyRules,
  });
}

class Coupon {
  final String id;
  final String code;
  final int value;
  final DateTime expiry;
  final String condition;
  final bool isUsed;

  Coupon({
    required this.id,
    required this.code,
    required this.value,
    required this.expiry,
    required this.condition,
    required this.isUsed,
  });

  Coupon copyWith({bool? isUsed}) {
    return Coupon(
      id: id,
      code: code,
      value: value,
      expiry: expiry,
      condition: condition,
      isUsed: isUsed ?? this.isUsed,
    );
  }

  bool get isValid => !isUsed && expiry.isAfter(DateTime.now());
}

class GameState {
  final GameStatus status;
  final int score;
  final int opponentScore;
  final int timeLeft;

  GameState({
    required this.status,
    required this.score,
    required this.opponentScore,
    required this.timeLeft,
  });

  GameState copyWith({
    GameStatus? status,
    int? score,
    int? opponentScore,
    int? timeLeft,
  }) {
    return GameState(
      status: status ?? this.status,
      score: score ?? this.score,
      opponentScore: opponentScore ?? this.opponentScore,
      timeLeft: timeLeft ?? this.timeLeft,
    );
  }
}

enum GameStatus { lobby, playing, won, lost }

