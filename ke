                      ),
                    ),
                  );
                }),
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(16),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                FloatingActionButton(
                  onPressed: () {
                    Provider.of<GameProvider>(
                      context,
                      listen: false,
                    ).updateScore(10);
                  },
                  backgroundColor: const Color(0xFFD4AF37),
                  child: const Icon(Icons.add, color: Colors.black),
                ),
                FloatingActionButton(
                  onPressed: () {},
                  backgroundColor: Colors.white24,
                  child: const Icon(Icons.mic, color: Colors.white),
                ),
                FloatingActionButton(
                  onPressed: () {},
                  backgroundColor: Colors.white24,
                  child: const Icon(Icons.music_note, color: Colors.white),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildResultScreen(BuildContext context, bool isWin) {
    return Container(
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            isWin ? const Color(0xFF0A2E36) : const Color(0xFF4A1C1C),
            isWin ? const Color(0xFF1A3E46) : const Color(0xFF6A2C2C),
          ],
        ),
      ),
      child: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(
              isWin
                  ? AppLocalizations.of(context, 'you_win')
                  : AppLocalizations.of(context, 'you_lose'),
              style: const TextStyle(
                fontSize: 48,
                fontWeight: FontWeight.bold,
                color: Colors.white,
              ),
            ),
            const SizedBox(height: 20),
            isWin
                ? Text(
                    '+500 ${AppLocalizations.of(context, 'balance')}',
                    style: const TextStyle(fontSize: 24, color: Colors.white),
                  )
                : const SizedBox(),
            const SizedBox(height: 40),
            ElevatedButton(
              onPressed: () {
                Provider.of<GameProvider>(context, listen: false).startGame();
              },
              style: ElevatedButton.styleFrom(
                backgroundColor: isWin ? const Color(0xFFD4AF37) : Colors.white,
                foregroundColor: isWin ? Colors.black : Colors.red,
                padding: const EdgeInsets.symmetric(
                  horizontal: 40,
                  vertical: 16,
                ),
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(30),
                ),
              ),
              child: Text(
                AppLocalizations.of(context, 'play_again'),
                style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
              ),
            ),
            const SizedBox(height: 20),
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: Text(
                AppLocalizations.of(context, 'back_to_home'),
                style: const TextStyle(fontSize: 18, color: Colors.white70),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

