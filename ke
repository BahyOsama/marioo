// Tournament Creation Screen
class TournamentCreationScreen extends StatefulWidget {
  const TournamentCreationScreen({super.key});

  @override
  State<TournamentCreationScreen> createState() =>
      _TournamentCreationScreenState();
}

class _TournamentCreationScreenState extends State<TournamentCreationScreen> {
  final _formKey = GlobalKey<FormState>();
  final _nameController = TextEditingController();
  int _prize = 1000;
  int _maxPlayers = 32;
  int _rounds = 3;
  int _winCondition = 100;
  DateTime _startDate = DateTime.now().add(const Duration(days: 1));
  String _emergencyRules = 'إلغاء البطولة عند اكتشاف الغش';

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Form(
        key: _formKey,
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            TextFormField(
              controller: _nameController,
              decoration: InputDecoration(
                labelText: AppLocalizations.of(context, 'tournament_name'),
                border: const OutlineInputBorder(),
              ),
              validator: (value) {
                if (value == null || value.isEmpty) {
                  return 'Please enter tournament name';
                }
                return null;
              },
            ),
            const SizedBox(height: 16),
            Text('${AppLocalizations.of(context, 'prize')}: $_prize'),
            Slider(
              value: _prize.toDouble(),
              min: 500,
              max: 10000,
              divisions: 19,
              label: '$_prize',
              onChanged: (value) {
                setState(() {
                  _prize = value.round();
                });
              },
            ),
            const SizedBox(height: 16),
            Text(
              '${AppLocalizations.of(context, 'max_players')}: $_maxPlayers',
            ),
            Slider(
              value: _maxPlayers.toDouble(),
              min: 2,
              max: 100,
              divisions: 49,
              label: '$_maxPlayers',
              onChanged: (value) {
                setState(() {
                  _maxPlayers = value.round();
                });
              },
            ),
            const SizedBox(height: 16),
            Text('${AppLocalizations.of(context, 'rounds')}: $_rounds'),
            Slider(
              value: _rounds.toDouble(),
              min: 1,
              max: 10,
              divisions: 9,
              label: '$_rounds',
              onChanged: (value) {
                setState(() {
                  _rounds = value.round();
                });
              },
            ),
            const SizedBox(height: 16),
            Text(
              '${AppLocalizations.of(context, 'win_condition')}: $_winCondition',
            ),
            Slider(
              value: _winCondition.toDouble(),
              min: 50,
              max: 200,
              divisions: 30,
              label: '$_winCondition',
              onChanged: (value) {
                setState(() {
                  _winCondition = value.round();
                });
              },
            ),
            const SizedBox(height: 16),
            ListTile(
              title: Text(
                '${AppLocalizations.of(context, 'start_date')}: ${DateFormat.yMd().format(_startDate)}',
              ),
              trailing: const Icon(Icons.calendar_today),
              onTap: () async {
                final pickedDate = await showDatePicker(
                  context: context,
                  initialDate: _startDate,
                  firstDate: DateTime.now(),
                  lastDate: DateTime.now().add(const Duration(days: 365)),
                );
                if (pickedDate != null) {
                  setState(() {
                    _startDate = pickedDate;
                  });
                }
              },
            ),
            const SizedBox(height: 16),
            TextFormField(
              initialValue: _emergencyRules,
              decoration: InputDecoration(
                labelText: AppLocalizations.of(context, 'emergency_rules'),
                border: const OutlineInputBorder(),
              ),
              maxLines: 3,
              onChanged: (value) {
                _emergencyRules = value;
              },
            ),
            const SizedBox(height: 24),
            Center(
              child: ElevatedButton(
                onPressed: () {
                  if (_formKey.currentState!.validate()) {
                    final tournament = Tournament(
                      id: 't${DateTime.now().millisecondsSinceEpoch}',
                      name: _nameController.text,
                      prize: _prize,
                      players: 0,
                      maxPlayers: _maxPlayers,
                      startTime: _startDate,
                      rules: TournamentRules(
                        rounds: _rounds,
                        winCondition: _winCondition,
                        emergencyRules: _emergencyRules,
                      ),
                    );

                    Provider.of<TournamentProvider>(
                      context,
                      listen: false,
                    ).createTournament(tournament);

                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text(
                          '${AppLocalizations.of(context, 'tournament_created')}!',
                        ),
                      ),
                    );

                    Navigator.pop(context);
                  }
                },
                style: ElevatedButton.styleFrom(
                  padding: const EdgeInsets.symmetric(horizontal: 40, vertical: 16),
                ),
                child: Text(AppLocalizations.of(context, 'create_tournament')),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

